generator client {
    provider = "prisma-client"
    output   = "../generated/prisma"
}

datasource db {
    provider = "postgresql"
}

enum Role {
    CUSTOMER
    AGENT
    ADMIN
}

enum TicketStatus {
    OPEN
    IN_PROGRESS
    WAITING_ON_CUSTOMER
    RESOLVED
    CLOSED
}

enum Priority {
    LOW
    MEDIUM
    HIGH
    URGENT
}

model User {
    id           String   @id @default(cuid())
    email        String   @unique
    name         String
    passwordHash String
    role         Role     @default(CUSTOMER)
    createdAt    DateTime @default(now())

    ticketsCreated  Ticket[]   @relation("Requester")
    ticketsAssigned Ticket[]   @relation("Assignee")
    comments        Comment[]
    auditLogs       AuditLog[]
}

model Ticket {
    id          String       @id @default(cuid())
    number      Int          @unique @default(autoincrement())
    subject     String
    description String
    status      TicketStatus @default(OPEN)
    priority    Priority     @default(MEDIUM)
    category    String?
    createdAt   DateTime     @default(now())
    updatedAt   DateTime     @updatedAt
    resolvedAt  DateTime?
    dueAt       DateTime? // SLA deadline, used in weeks 5-6

    requesterId String
    requester   User    @relation("Requester", fields: [requesterId], references: [id])
    assigneeId  String?
    assignee    User?   @relation("Assignee", fields: [assigneeId], references: [id])

    comments    Comment[]
    attachments Attachment[]
    auditLogs   AuditLog[]

    @@index([status, priority])
    @@index([assigneeId])
    @@index([requesterId])
    @@index([createdAt])
}

model Comment {
    id         String   @id @default(cuid())
    body       String
    isInternal Boolean  @default(false) // agent-only notes
    createdAt  DateTime @default(now())

    ticketId String
    ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
    authorId String
    author   User   @relation(fields: [authorId], references: [id])

    @@index([ticketId, createdAt])
}

model Attachment {
    id        String   @id @default(cuid())
    fileName  String
    url       String
    sizeBytes Int
    createdAt DateTime @default(now())

    ticketId String
    ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
}

model AuditLog {
    id        String   @id @default(cuid())
    action    String // e.g. "STATUS_CHANGED"
    from      String?
    to        String?
    createdAt DateTime @default(now())

    ticketId String
    ticket   Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
    actorId  String
    actor    User   @relation(fields: [actorId], references: [id])

    @@index([ticketId, createdAt])
}
